-- ============================================================
-- SMART FOOD PLANNER
-- DATABASE FOR REACT + NODE.JS APPLICATION
-- ============================================================

-- Create database
CREATE DATABASE IF NOT EXISTS smart_food_planner;

-- Select database
USE smart_food_planner;


-- ============================================================
-- REMOVE OLD TABLES
-- ============================================================

DROP TABLE IF EXISTS food_plan_ingredients;
DROP TABLE IF EXISTS food_plans;
DROP TABLE IF EXISTS meal_schedules;
DROP TABLE IF EXISTS ingredients;
DROP TABLE IF EXISTS inventory;
DROP TABLE IF EXISTS menus;


-- ============================================================
-- 1. MENUS
-- Used by:
-- Dashboard
-- Menus
-- Food Calculator
-- Meal Schedule
-- ============================================================

CREATE TABLE menus (
    id INT AUTO_INCREMENT PRIMARY KEY,

    name VARCHAR(100) NOT NULL,

    meal VARCHAR(50) NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================
-- 2. INGREDIENTS
-- Each menu can have multiple ingredients
-- ============================================================

CREATE TABLE ingredients (
    id INT AUTO_INCREMENT PRIMARY KEY,

    menu_id INT NOT NULL,

    name VARCHAR(100) NOT NULL,

    quantity_per_person DECIMAL(10,3) NOT NULL,

    unit VARCHAR(30) NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (menu_id)
        REFERENCES menus(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


-- ============================================================
-- 3. INVENTORY
-- Used by:
-- Inventory page
-- Dashboard low-stock section
-- Food plan inventory deduction
-- ============================================================

CREATE TABLE inventory (
    id INT AUTO_INCREMENT PRIMARY KEY,

    item_name VARCHAR(100) NOT NULL,

    quantity DECIMAL(10,3) NOT NULL DEFAULT 0,

    unit VARCHAR(30) NOT NULL,

    minimum_stock DECIMAL(10,3) NOT NULL DEFAULT 0,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP
);


-- ============================================================
-- 4. MEAL SCHEDULES
-- Used by:
-- Meal Schedule page
-- Dashboard
-- Today's Kitchen
-- ============================================================

CREATE TABLE meal_schedules (
    id INT AUTO_INCREMENT PRIMARY KEY,

    schedule_date DATE NOT NULL,

    meal_type VARCHAR(30) NOT NULL,

    meal_time TIME NOT NULL,

    menu_id INT NOT NULL,

    people INT NOT NULL,

    status VARCHAR(30) NOT NULL DEFAULT 'Planned',

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (menu_id)
        REFERENCES menus(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


-- ============================================================
-- 5. FOOD PLANS
-- Used by:
-- Food Calculator
-- Dashboard
-- Food Plan History
-- ============================================================

CREATE TABLE food_plans (
    id INT AUTO_INCREMENT PRIMARY KEY,

    plan_date DATE NOT NULL,

    people INT NOT NULL,

    meal VARCHAR(50) NOT NULL,

    menu VARCHAR(100) NOT NULL,

    safety_buffer DECIMAL(5,2) NOT NULL DEFAULT 0,

    effective_people INT NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================
-- 6. FOOD PLAN INGREDIENTS
-- Stores calculated ingredient quantities
-- ============================================================

CREATE TABLE food_plan_ingredients (
    id INT AUTO_INCREMENT PRIMARY KEY,

    food_plan_id INT NOT NULL,

    name VARCHAR(100) NOT NULL,

    total_quantity DECIMAL(10,3) NOT NULL,

    unit VARCHAR(30) NOT NULL,

    FOREIGN KEY (food_plan_id)
        REFERENCES food_plans(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


