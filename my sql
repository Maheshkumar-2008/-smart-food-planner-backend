    (SELECT COUNT(*) FROM menus) AS menus,
    (SELECT COUNT(*) FROM inventory) AS inventory,
    (
        SELECT COUNT(*)
        FROM inventory
        WHERE quantity <= minimum_stock
    ) AS lowStock;